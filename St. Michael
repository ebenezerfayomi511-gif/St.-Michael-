<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SchoolLink – Results Portal</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#0f1923;--cream:#f5f0e8;--gold:#c9a84c;--gold-light:#e8d5a3;
  --sage:#3d6b5e;--sage-light:#e8f0ee;--red:#c0392b;--card:#fff;
  --border:#e2ddd4;--muted:#7a7060;--r:12px;
  --sh:0 4px 24px rgba(15,25,35,.10);--shl:0 12px 48px rgba(15,25,35,.15);
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'DM Sans',sans-serif;background:var(--cream);color:var(--ink);min-height:100vh;}
#splash{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--ink);padding:2rem;text-align:center;position:relative;overflow:hidden;}
#splash::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 30% 20%,#1e3a2e 0%,transparent 60%),radial-gradient(ellipse at 70% 80%,#2a1a0a 0%,transparent 60%);}
.spl-logo{font-family:'Playfair Display',serif;font-size:clamp(2.8rem,8vw,5rem);font-weight:900;color:var(--gold);letter-spacing:-1px;position:relative;z-index:1;line-height:1;}
.spl-tag{color:rgba(255,255,255,.55);font-size:.95rem;letter-spacing:.12em;text-transform:uppercase;margin-top:.5rem;position:relative;z-index:1;}
.spl-div{width:60px;height:2px;background:var(--gold);margin:2.5rem auto;position:relative;z-index:1;}
.spl-btns{display:flex;flex-direction:column;gap:1rem;width:100%;max-width:320px;position:relative;z-index:1;}
.btn-p{background:var(--gold);color:var(--ink);border:none;padding:1rem 1.5rem;border-radius:var(--r);font-family:'DM Sans',sans-serif;font-weight:600;font-size:1rem;cursor:pointer;transition:transform .15s,box-shadow .15s;}
.btn-p:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(201,168,76,.4);}
.btn-s{background:transparent;color:var(--gold-light);border:1.5px solid rgba(201,168,76,.4);padding:1rem 1.5rem;border-radius:var(--r);font-family:'DM Sans',sans-serif;font-weight:500;font-size:1rem;cursor:pointer;}
.btn-s:hover{border-color:var(--gold);background:rgba(201,168,76,.08);}
.btn-g{background:transparent;color:var(--muted);border:1.5px solid var(--border);padding:.75rem 1.5rem;border-radius:var(--r);font-family:'DM Sans',sans-serif;font-weight:500;font-size:.9rem;cursor:pointer;width:100%;margin-top:.5rem;}
.btn-g:hover{border-color:var(--ink);color:var(--ink);}
.btn-sage{background:var(--sage);color:#fff;border:none;padding:.9rem 1.5rem;border-radius:var(--r);font-family:'DM Sans',sans-serif;font-weight:600;font-size:.95rem;cursor:pointer;width:100%;transition:opacity .15s;}
.btn-sage:hover{opacity:.88;}
.btn-sm{padding:.45rem .9rem!important;font-size:.8rem!important;border-radius:7px!important;width:auto!important;}
.btn-red{background:var(--red);color:#fff;border:none;padding:.7rem 1.2rem;border-radius:8px;font-family:'DM Sans',sans-serif;font-weight:600;font-size:.85rem;cursor:pointer;}
.screen{display:none;min-height:100vh;flex-direction:column;animation:fadeIn .3s ease;}
.screen.active{display:flex;}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:none;}}
.topbar{background:var(--ink);display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;position:sticky;top:0;z-index:50;}
.tb-brand{font-family:'Playfair Display',serif;font-size:1.4rem;font-weight:700;color:var(--gold);letter-spacing:-.5px;}
.tb-back{background:none;border:none;color:var(--gold-light);font-size:1.3rem;cursor:pointer;padding:.25rem;line-height:1;}
.tb-act{background:none;border:none;color:rgba(255,255,255,.5);font-family:'DM Sans',sans-serif;font-size:.85rem;cursor:pointer;padding:.25rem;}
.tb-act:hover{color:var(--gold);}
.content{padding:1.5rem 1.25rem;flex:1;max-width:680px;width:100%;margin:0 auto;}
.fg{margin-bottom:1.25rem;}
label{display:block;font-size:.82rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:.45rem;}
input,select,textarea{width:100%;padding:.85rem 1rem;border:1.5px solid var(--border);border-radius:8px;font-family:'DM Sans',sans-serif;font-size:.95rem;color:var(--ink);background:#fff;transition:border-color .15s;outline:none;}
input:focus,select:focus,textarea:focus{border-color:var(--gold);}
textarea{resize:vertical;min-height:70px;}
.hint{font-size:.78rem;color:var(--muted);margin-top:.35rem;}
.card{background:var(--card);border:1.5px solid var(--border);border-radius:var(--r);padding:1.25rem;margin-bottom:1rem;box-shadow:var(--sh);}
.card-title{font-family:'Playfair Display',serif;font-size:1.05rem;font-weight:700;margin-bottom:.25rem;}
.card-sub{font-size:.82rem;color:var(--muted);}
.card-row{display:flex;align-items:center;justify-content:space-between;}
.badge{display:inline-block;padding:.2rem .65rem;border-radius:50px;font-size:.72rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;}
.bg{background:var(--gold-light);color:#7a5a00;}
.bs{background:var(--sage-light);color:var(--sage);}
.br{background:#fdecea;color:var(--red);}
.sh{font-family:'Playfair Display',serif;font-size:1.6rem;font-weight:700;margin-bottom:.35rem;line-height:1.2;}
.ss{color:var(--muted);font-size:.88rem;margin-bottom:1.75rem;}
.notice{background:var(--sage-light);border-left:3px solid var(--sage);border-radius:6px;padding:.85rem 1rem;font-size:.85rem;color:var(--sage);margin-bottom:1.25rem;}
.n-err{background:#fdecea;border-left-color:var(--red);color:var(--red);}
.n-warn{background:#fef9e7;border-left-color:var(--gold);color:#7a5a00;}
.chip-list{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:.75rem;min-height:34px;}
.chip{display:flex;align-items:center;gap:.4rem;background:#fff;border:1.5px solid var(--border);border-radius:50px;padding:.35rem .75rem;font-size:.83rem;font-weight:500;}
.chip-x{background:none;border:none;color:var(--red);cursor:pointer;font-size:1rem;line-height:1;padding:0;}
.add-subj-row{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;}
.add-subj-row .sn{flex:2;min-width:120px;}
.btn-add-subj{flex-shrink:0;background:var(--sage);color:#fff;border:none;padding:.65rem .95rem;border-radius:8px;font-family:'DM Sans',sans-serif;font-weight:600;font-size:.83rem;cursor:pointer;white-space:nowrap;}
.tbl-wrap{overflow-x:auto;border:1.5px solid var(--border);border-radius:var(--r);background:#fff;}
.stbl{width:100%;border-collapse:collapse;font-size:.78rem;}
.stbl .gh th{background:#1a2e3b;color:rgba(255,255,255,.5);padding:.35rem .6rem;font-size:.65rem;letter-spacing:.08em;text-transform:uppercase;text-align:center;font-weight:600;border-right:2px solid #2a3f50;}
.stbl .gh th:first-child{text-align:left;border-right:none;}
.stbl .gh th:nth-child(2){border-right:none;}
.stbl .fh th{background:var(--ink);color:var(--gold-light);padding:.55rem .55rem;text-align:center;font-size:.68rem;letter-spacing:.07em;text-transform:uppercase;font-weight:600;white-space:nowrap;}
.stbl .fh th:first-child,.stbl .fh th:nth-child(2){text-align:left;}
.stbl td{padding:.38rem .45rem;border-bottom:1px solid var(--border);vertical-align:middle;text-align:center;}
.stbl td:first-child,.stbl td:nth-child(2){text-align:left;}
.stbl tr:last-child td{border-bottom:none;}
.stbl .subj-sep{border-right:2px solid var(--border);}
.stbl input{padding:.42rem .45rem;font-size:.8rem;border-radius:5px;width:52px!important;text-align:center;}
.total-cell{font-weight:700;background:#f5f8f5!important;}
.pct-cell{font-weight:700;color:var(--sage);}
.btn-row-del{background:none;border:none;color:var(--red);font-size:1.1rem;cursor:pointer;padding:.15rem .35rem;line-height:1;}
.btn-add-row{background:var(--sage-light);color:var(--sage);border:1.5px dashed var(--sage);padding:.65rem;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:.88rem;font-weight:600;cursor:pointer;width:100%;margin-top:.5rem;}
.btn-add-row:hover{background:#d4e8e3;}
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:1.25rem;}
.stat-card{background:var(--card);border:1.5px solid var(--border);border-radius:var(--r);padding:1rem;text-align:center;}
.stat-n{font-family:'Playfair Display',serif;font-size:1.8rem;font-weight:700;color:var(--sage);line-height:1;}
.stat-l{font-size:.75rem;color:var(--muted);margin-top:.25rem;text-transform:uppercase;letter-spacing:.06em;}
.gA{color:#1a7a3a;font-weight:700;} .gB{color:#2d6abf;font-weight:700;}
.gC{color:#b5860d;font-weight:700;} .gD{color:#c05c00;font-weight:700;} .gF{color:var(--red);font-weight:700;}
.bar-w{background:var(--border);border-radius:50px;height:8px;overflow:hidden;flex:1;}
.bar-f{height:100%;border-radius:50px;transition:width .8s ease;}
.svr{padding:.65rem 0;border-bottom:1px solid var(--border);}
.svr:last-child{border-bottom:none;}
.svr-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:.35rem;}
.svr-name{font-weight:600;font-size:.88rem;}
.svr-scores{display:flex;gap:.75rem;}
.svr-score-item{text-align:center;}
.svr-score-val{font-family:'Playfair Display',serif;font-size:1rem;font-weight:700;}
.svr-score-lbl{font-size:.65rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;}
.svr-bar-row{display:flex;align-items:center;gap:.65rem;}
.avatar{width:42px;height:42px;border-radius:50%;background:var(--gold-light);color:#7a5a00;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-weight:700;font-size:1.1rem;flex-shrink:0;}
.flex-c{display:flex;align-items:center;gap:.75rem;}
.mt1{margin-top:1rem;} .mt2{margin-top:1.5rem;}
.small{font-size:.82rem;color:var(--muted);}
.tc{text-align:center;}
.step-lbl{font-family:'Playfair Display',serif;font-size:.95rem;font-weight:700;color:var(--sage);margin-bottom:.85rem;}
.empty{text-align:center;padding:3rem 1rem;color:var(--muted);}
.empty-ico{font-size:2.5rem;margin-bottom:.75rem;}
.empty-t{font-family:'Playfair Display',serif;font-size:1.2rem;color:var(--ink);margin-bottom:.5rem;}
.score-scheme-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.65rem;margin-bottom:1rem;}
.scheme-box{background:var(--sage-light);border:1.5px solid var(--sage);border-radius:8px;padding:.75rem;text-align:center;}
.scheme-val{font-family:'Playfair Display',serif;font-size:1.4rem;font-weight:700;color:var(--sage);}
.scheme-lbl{font-size:.7rem;color:var(--sage);text-transform:uppercase;letter-spacing:.06em;margin-top:.15rem;}
.student-remark-block{background:#fafaf8;border:1.5px solid var(--border);border-radius:10px;margin-bottom:.65rem;overflow:hidden;}
.srb-header{display:flex;align-items:center;justify-content:space-between;padding:.75rem 1rem;cursor:pointer;background:#fff;}
.srb-name{font-weight:600;font-size:.9rem;}
.srb-toggle{font-size:.85rem;color:var(--muted);transition:transform .2s;}
.srb-body{padding:.75rem 1rem;border-top:1px solid var(--border);display:none;}
.srb-body.open{display:block;}
.debt-toggle{display:flex;align-items:center;gap:.5rem;margin-top:.65rem;}
.debt-toggle input[type=checkbox]{width:auto;margin:0;}
.debt-toggle label{text-transform:none;letter-spacing:0;font-size:.85rem;color:var(--ink);font-weight:500;margin:0;}
.report-card{background:#fff;border:2px solid var(--ink);border-radius:var(--r);padding:1.5rem;margin-bottom:1.5rem;box-shadow:var(--shl);}
.rc-header{text-align:center;border-bottom:2px solid var(--border);padding-bottom:1rem;margin-bottom:1rem;}
.rc-school{font-family:'Playfair Display',serif;font-size:1.2rem;font-weight:900;color:var(--ink);}
.rc-title{font-size:.75rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-top:.2rem;}
.rc-info-grid{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin-bottom:1rem;font-size:.82rem;}
.rc-info-item{background:var(--cream);border-radius:6px;padding:.5rem .75rem;}
.rc-info-lbl{font-size:.65rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:.1rem;}
.rc-info-val{font-weight:700;font-size:.9rem;}
.rc-subj-table{width:100%;border-collapse:collapse;font-size:.82rem;margin-bottom:1rem;}
.rc-subj-table th{background:var(--ink);color:var(--gold-light);padding:.5rem .6rem;text-align:left;font-size:.7rem;letter-spacing:.07em;text-transform:uppercase;}
.rc-subj-table td{padding:.5rem .6rem;border-bottom:1px solid var(--border);}
.rc-subj-table tr:last-child td{border-bottom:none;}
.rc-subj-table tr:nth-child(even) td{background:#fafaf8;}
.rc-remark-box{background:var(--cream);border-radius:8px;padding:.85rem 1rem;margin-bottom:.75rem;}
.rc-remark-lbl{font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);font-weight:700;margin-bottom:.3rem;}
.rc-remark-text{font-size:.88rem;font-style:italic;color:var(--ink);line-height:1.5;}
.rc-remark-sign{font-size:.75rem;color:var(--muted);margin-top:.4rem;text-align:right;}
.rc-resumption{background:var(--sage-light);border:1.5px solid var(--sage);border-radius:8px;padding:.75rem 1rem;text-align:center;margin-bottom:.75rem;}
.rc-resumption-lbl{font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;color:var(--sage);font-weight:700;}
.rc-resumption-date{font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--sage);margin-top:.2rem;}
.rc-footer{text-align:center;font-size:.72rem;color:var(--muted);border-top:1px solid var(--border);padding-top:.75rem;margin-top:.75rem;}
.debt-block{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--ink);padding:2rem;text-align:center;}
.debt-icon{font-size:4rem;margin-bottom:1rem;}
.debt-title{font-family:'Playfair Display',serif;font-size:1.8rem;font-weight:900;color:var(--red);margin-bottom:.75rem;}
.debt-msg{color:rgba(255,255,255,.7);font-size:.95rem;max-width:320px;line-height:1.6;margin-bottom:1.5rem;}
.debt-contact{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:var(--r);padding:1rem;color:#fff;font-size:.88rem;}
#install-banner{position:fixed;bottom:1rem;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:.85rem 1.25rem;border-radius:50px;box-shadow:var(--shl);display:flex;align-items:center;gap:.75rem;font-size:.85rem;z-index:999;max-width:90vw;animation:slideUp .4s ease;}
@keyframes slideUp{from{transform:translateX(-50%) translateY(20px);opacity:0;}to{transform:translateX(-50%) translateY(0);opacity:1;}}
#install-banner button{background:var(--gold);color:var(--ink);border:none;padding:.45rem 1rem;border-radius:50px;font-weight:700;font-size:.82rem;cursor:pointer;white-space:nowrap;}
.x-banner{background:none!important;border:none!important;color:rgba(255,255,255,.5)!important;cursor:pointer;font-size:1.1rem;padding:0!important;line-height:1;}
::-webkit-scrollbar{width:5px;height:5px;} ::-webkit-scrollbar-thumb{background:var(--border);border-radius:10px;}
@media print{
  .topbar,.btn-sage,.btn-p,.btn-g,.btn-s,#install-banner,.tb-back,.tb-act{display:none!important;}
  .report-card{box-shadow:none;border:1.5px solid #ccc;page-break-after:always;}
  body{background:#fff;}
}
</style>
</head>
<body>

<div id="splash">
  <div class="spl-logo">SchoolLink</div>
  <div class="spl-tag">Results Management Portal</div>
  <div class="spl-div"></div>
  <div class="spl-btns">
    <button class="btn-p" onclick="showScreen('teacher-login')">🎓 Teacher Login</button>
    <button class="btn-s" onclick="showScreen('parent-login')">👨‍👩‍👧 Parent / Guardian</button>
    <button class="btn-s" style="font-size:.85rem;padding:.7rem" onclick="showScreen('teacher-register')">New Teacher? Register Here</button>
    <button class="btn-s" style="font-size:.85rem;padding:.7rem;margin-top:.25rem" onclick="showScreen('headteacher-login')">🏫 Head Teacher Login</button>
  </div>
</div>

<div class="screen" id="screen-teacher-register">
  <div class="topbar"><button class="tb-back" onclick="goHome()">← Back</button><span class="tb-brand">SchoolLink</span><span></span></div>
  <div class="content">
    <div class="sh">Create Account</div><div class="ss">Register as a teacher to upload results</div>
    <div class="card">
      <div class="fg"><label>Full Name</label><input type="text" id="reg-name" placeholder="e.g. Mrs. Amaka Okonkwo"></div>
      <div class="fg"><label>Email Address</label><input type="email" id="reg-email" placeholder="teacher@school.edu"></div>
      <div class="fg"><label>Your Class</label><input type="text" id="reg-class" placeholder="e.g. JSS 2A, SS3 Science"></div>
      <div class="fg"><label>Teacher Registration Code</label><input type="text" id="reg-code" placeholder="Code from school admin"><div class="hint">Ask your school administrator for the registration code.</div></div>
      <div class="fg"><label>Choose Password</label><input type="password" id="reg-pass" placeholder="Min. 6 characters"></div>
      <div class="fg"><label>Confirm Password</label><input type="password" id="reg-pass2" placeholder="Re-enter password"></div>
      <div id="reg-err" class="notice n-err" style="display:none"></div>
      <button class="btn-sage" onclick="registerTeacher()">Create Account</button>
    </div>
  </div>
</div>

<div class="screen" id="screen-teacher-login">
  <div class="topbar"><button class="tb-back" onclick="goHome()">← Back</button><span class="tb-brand">SchoolLink</span><span></span></div>
  <div class="content">
    <div class="sh">Teacher Login</div><div class="ss">Access your class results dashboard</div>
    <div class="card">
      <div class="fg"><label>Email Address</label><input type="email" id="tl-email" placeholder="teacher@school.edu"></div>
      <div class="fg"><label>Password</label><input type="password" id="tl-pass" placeholder="Your chosen password"></div>
      <div id="tl-err" class="notice n-err" style="display:none"></div>
      <button class="btn-sage" onclick="loginTeacher()">Login</button>
      <button class="btn-g" onclick="showScreen('teacher-register')">Don't have an account? Register</button>
    </div>
  </div>
</div>

<div class="screen" id="screen-headteacher-login">
  <div class="topbar"><button class="tb-back" onclick="goHome()">← Back</button><span class="tb-brand">SchoolLink</span><span></span></div>
  <div class="content">
    <div class="sh">Head Teacher</div><div class="ss">Login to add remarks and manage results</div>
    <div class="card">
      <div class="fg"><label>Head Teacher Password</label><input type="password" id="ht-pass" placeholder="Head teacher password"></div>
      <div id="ht-err" class="notice n-err" style="display:none"></div>
      <button class="btn-sage" onclick="loginHeadTeacher()">Login</button>
      <div class="hint" style="margin-top:.5rem;text-align:center">Default password: <strong>HEAD2024</strong> — change in settings</div>
    </div>
  </div>
</div>

<div class="screen" id="screen-headteacher-dashboard">
  <div class="topbar"><button class="tb-back" onclick="logoutHT()">← Logout</button><span class="tb-brand">Head Teacher</span><span></span></div>
  <div class="content">
    <div class="sh">Head Teacher Panel</div>
    <div class="ss">Add remarks to student report cards across all classes</div>
    <div class="card">
      <div class="step-lbl" style="margin-bottom:.65rem">🏫 School Settings</div>
      <div class="fg"><label>School Name</label><input type="text" id="ht-school-name" placeholder="e.g. St. Michael Nursery & Primary School"></div>
      <div class="fg"><label>Next Resumption Date</label><input type="date" id="ht-resumption"></div>
      <div class="fg"><label>Head Teacher's Name</label><input type="text" id="ht-htname" placeholder="e.g. Mr. Emmanuel Obi"></div>
      <div class="fg"><label>Change Head Teacher Password</label><input type="password" id="ht-newpass" placeholder="Leave blank to keep current"></div>
      <button class="btn-sage" onclick="saveHTSettings()">💾 Save Settings</button>
    </div>
    <div style="font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;margin-bottom:.75rem">All Result Sets</div>
    <div id="ht-results-list"><div class="empty"><div class="empty-ico">📋</div><div class="empty-t">No results published yet</div></div></div>
  </div>
</div>

<div class="screen" id="screen-ht-remarks">
  <div class="topbar"><button class="tb-back" onclick="showScreen('headteacher-dashboard')">← Back</button><span class="tb-brand">HT Remarks</span><span></span></div>
  <div class="content">
    <div class="sh" id="ht-rem-title">Add Remarks</div>
    <div class="ss" id="ht-rem-sub"></div>
    <div class="notice">Write your individual remark for each student. You can also mark students who owe school fees — they will not be able to view results.</div>
    <div id="ht-remarks-list"></div>
    <button class="btn-sage mt1" onclick="saveHTRemarks()">💾 Save All Remarks</button>
    <div style="height:2rem"></div>
  </div>
</div>

<div class="screen" id="screen-teacher-dashboard">
  <div class="topbar"><button class="tb-back" onclick="logoutTeacher()">← Logout</button><span class="tb-brand">SchoolLink</span><button class="tb-act" onclick="showScreen('upload-results')">+ Upload</button></div>
  <div class="content">
    <div style="margin-bottom:1.25rem">
      <div class="sh" id="t-name-disp">Welcome</div>
      <div class="ss" id="t-class-disp"></div>
    </div>
    <div class="stat-grid">
      <div class="stat-card"><div class="stat-n" id="stat-up">0</div><div class="stat-l">Result Sets</div></div>
