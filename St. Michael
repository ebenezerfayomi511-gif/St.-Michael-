<script>
const TEACHER_CODE="SCHOOL2024";
const KEY='schoollink_v4';
function load(){return JSON.parse(localStorage.getItem(KEY)||JSON.stringify({teachers:[],results:[],settings:{schoolName:'',resumption:'',htName:'',htPass:'HEAD2024'}}));}
function save(d){localStorage.setItem(KEY,JSON.stringify(d));}
function getSettings(){const d=load();return d.settings||{schoolName:'',resumption:'',htName:'',htPass:'HEAD2024'};}
let cTeacher=null,cResultId=null,fSubjects=[],rowCnt=0,htLoggedIn=false,htCurrentResultId=null;
function showScreen(name){el('splash').style.display='none';document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));const sc=el('screen-'+name);if(sc)sc.classList.add('active');if(name==='teacher-dashboard')refreshDash();if(name==='upload-results')initForm();if(name==='headteacher-dashboard')refreshHTDash();}
function goHome(){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));el('splash').style.display='flex';}
function registerTeacher(){const name=v('reg-name'),email=v('reg-email').toLowerCase(),cls=v('reg-class'),code=v('reg-code'),pass=v('reg-pass'),pass2=v('reg-pass2'),err=el('reg-err');err.style.display='none';if(!name||!email||!cls||!code||!pass)return showErr(err,'Please fill in all fields.');if(code!==TEACHER_CODE)return showErr(err,'Invalid teacher code. Contact your school admin.');if(pass.length<6)return showErr(err,'Password must be at least 6 characters.');if(pass!==pass2)return showErr(err,'Passwords do not match.');const data=load();if(data.teachers.find(t=>t.email===email))return showErr(err,'Account already exists with this email.');const t={id:uid(),name,email,cls,password:btoa(pass)};data.teachers.push(t);save(data);cTeacher=t;showScreen('teacher-dashboard');}
function loginTeacher(){const email=v('tl-email').toLowerCase(),pass=v('tl-pass'),err=el('tl-err');err.style.display='none';const t=load().teachers.find(t=>t.email===email&&t.password===btoa(pass));if(!t)return showErr(err,'Invalid email or password.');cTeacher=t;showScreen('teacher-dashboard');}
function logoutTeacher(){cTeacher=null;goHome();}
function loginHeadTeacher(){const pass=v('ht-pass'),err=el('ht-err');err.style.display='none';const s=getSettings();if(pass!==(s.htPass||'HEAD2024'))return showErr(err,'Incorrect head teacher password.');htLoggedIn=true;showScreen('headteacher-dashboard');}
function logoutHT(){htLoggedIn=false;goHome();}
function refreshHTDash(){const s=getSettings();el('ht-school-name').value=s.schoolName||'';el('ht-resumption').value=s.resumption||'';el('ht-htname').value=s.htName||'';el('ht-newpass').value='';const data=load(),list=el('ht-results-list');if(!data.results.length){list.innerHTML='<div class="empty"><div class="empty-ico">📋</div><div class="empty-t">No results published yet</div></div>';return;}list.innerHTML=[...data.results].reverse().map(r=>`<div class="card"><div class="card-row"><div><div class="card-title">${r.term}</div><div class="card-sub">${r.cls} · ${r.session} · ${r.students.length} students · by ${r.teacherName}</div></div><button class="btn-p btn-sm" onclick="openHTRemarks('${r.id}')">✏️ Remarks</button></div></div>`).join('');}
function saveHTSettings(){const data=load();if(!data.settings)data.settings={};data.settings.schoolName=v('ht-school-name');data.settings.resumption=v('ht-resumption');data.settings.htName=v('ht-htname');const np=v('ht-newpass');if(np.trim())data.settings.htPass=np.trim();save(data);alert('✅ Settings saved!');}
function openHTRemarks(rid){htCurrentResultId=rid;const data=load(),r=data.results.find(x=>x.id===rid);if(!r)return;el('ht-rem-title').textContent=r.term;el('ht-rem-sub').textContent=r.cls+' · '+r.session;el('ht-remarks-list').innerHTML=r.students.map((s,i)=>`<div class="student-remark-block"><div class="srb-header" onclick="toggleSRB('ht-srb-${i}',this)"><div class="srb-name">${s.name} <span class="badge ${s.owesDebt?'br':'bs'}">${s.owesDebt?'⚠ Owes Fees':'✓ Clear'}</span></div><span class="srb-toggle">▼</span></div><div class="srb-body" id="ht-srb-${i}"><div class="fg" style="margin-bottom:.65rem"><label>Head Teacher's Remark for ${s.name.split(' ')[0]}</label><textarea id="ht-rem-${i}" placeholder="e.g. A diligent student with great potential...">${s.htRemark||''}</textarea></div><div class="debt-toggle"><input type="checkbox" id="ht-debt-${i}" ${s.owesDebt?'checked':''}><label for="ht-debt-${i}">⚠️ This student owes school fees (results will be blocked)</label></div></div></div>`).join('');showScreen('ht-remarks');}
function saveHTRemarks(){const data=load(),r=data.results.find(x=>x.id===htCurrentResultId);if(!r)return;r.students.forEach((s,i)=>{s.htRemark=el('ht-rem-'+i)?.value.trim()||'';s.owesDebt=el('ht-debt-'+i)?.checked||false;});save(data);alert('✅ Head teacher remarks saved!');showScreen('headteacher-dashboard');}
function toggleSRB(id,header){const body=el(id),isOpen=body.classList.contains('open');body.classList.toggle('open',!isOpen);header.querySelector('.srb-toggle').style.transform=isOpen?'':'rotate(180deg)';}
function refreshDash(){if(!cTeacher)return;el('t-name-disp').textContent='Hello, '+cTeacher.name.split(' ').slice(-1)[0]+' 👋';el('t-class-disp').textContent=cTeacher.cls;const data=load(),mine=data.results.filter(r=>r.teacherId===cTeacher.id);el('stat-up').textContent=mine.length;el('stat-stu').textContent=mine.reduce((a,r)=>a+r.students.length,0);const list=el('upload-list');if(!mine.length){list.innerHTML='<div class="empty"><div class="empty-ico">📋</div><div class="empty-t">No results yet</div><p>Tap "+ New" to upload your first result set.</p></div>';return;}list.innerHTML=[...mine].reverse().map(r=>`<div class="card" onclick="viewDetail('${r.id}')" style="cursor:pointer"><div class="card-row"><div><div class="card-title">${r.term}</div><div class="card-sub">${r.cls} · ${r.session} · ${r.students.length} student${r.students.length!==1?'s':''} · ${r.subjects.length} subject${r.subjects.length!==1?'s':''}</div><div class="card-sub" style="margin-top:.15rem">CA1(${r.scheme.ca1}) + CA2(${r.scheme.ca2}) + Exam(${r.scheme.exam}) = ${r.scheme.total}</div></div><span class="badge bs">Published</span></div></div>`).join('');}
const QUICK=['Mathematics','English Language','Basic Science','Social Studies','Civic Education','Agricultural Science','Computer Studies','Business Studies'];
function initForm(){el('up-term').value='';el('up-class').value=cTeacher?cTeacher.cls:'';el('up-session').value='';el('up-err').style.display='none';el('sch-ca1').value=20;el('sch-ca2').value=20;el('sch-exam').value=60;fSubjects=[];rowCnt=0;updateScheme();renderChips();buildHeader();el('tbl-body').innerHTML='';el('remarks-card').style.display='none';el('individual-remarks-list').innerHTML='';el('quick-btns').innerHTML=QUICK.map(s=>`<button onclick="quickAdd('${s}')" style="background:#fff;border:1.5px solid var(--border);border-radius:50px;padding:.25rem .7rem;font-size:.75rem;cursor:pointer;font-family:'DM Sans',sans-serif;" onmouseover="this.style.borderColor='var(--sage)'" onmouseout="this.style.borderColor='var(--border)'">${s}</button>`).join('');}
function getScheme(){const ca1=parseInt(el('sch-ca1').value)||20,ca2=parseInt(el('sch-ca2').value)||20,exam=parseInt(el('sch-exam').value)||60;return{ca1,ca2,exam,total:ca1+ca2+exam};}
function updateScheme(){const sc=getScheme();el('sch-ca1-disp').textContent=sc.ca1;el('sch-ca2-disp').textContent=sc.ca2;el('sch-exam-disp').textContent=sc.exam;el('scheme-total-label').innerHTML=`Total per subject: <strong>${sc.total}</strong>`;rebuildCols();}
function addSubject(){const name=v('new-subj').trim();if(!name){alert('Please enter a subject name.');return;}if(fSubjects.find(s=>s.name.toLowerCase()===name.toLowerCase())){alert('Subject already added.');return;}fSubjects.push({name});el('new-subj').value='';renderChips();rebuildCols();syncRemarksPanel();}
function quickAdd(name){if(fSubjects.find(s=>s.name.toLowerCase()===name.toLowerCase()))return;fSubjects.push({name});renderChips();rebuildCols();syncRemarksPanel();}
function removeSubj(i){fSubjects.splice(i,1);renderChips();rebuildCols();syncRemarksPanel();}
function renderChips(){el('subj-chips').innerHTML=fSubjects.length?fSubjects.map((s,i)=>`<div class="chip"><span>${s.name}</span><button class="chip-x" onclick="removeSubj(${i})">×</button></div>`).join(''):'<span class="small" style="color:var(--muted);align-self:center">No subjects added yet</span>';}
function buildHeader(){if(!fSubjects.length){el('tbl-head').innerHTML='';el('stu-notice').style.display='block';return;}el('stu-notice').style.display='none';const sc=getScheme();let gh=`<tr class="gh"><th rowspan="2" style="text-align:left;vertical-align:bottom">Student Name</th><th rowspan="2" style="text-align:left;vertical-align:bottom;min-width:105px">Parent Phone</th>`;fSubjects.forEach(s=>{gh+=`<th colspan="4" style="border-left:2px solid #2a3f50">${s.name}</th>`;});gh+=`<th colspan="2" style="border-left:2px solid #2a3f50">Overall</th><th rowspan="2"></th></tr>`;let fh=`<tr class="fh">`;fSubjects.forEach(()=>{fh+=`<th style="border-left:2px solid rgba(255,255,255,.15)">CA1<br><span style="opacity:.6;font-size:.6rem">/${sc.ca1}</span></th><th>CA2<br><span style="opacity:.6;font-size:.6rem">/${sc.ca2}</span></th><th>Exam<br><span style="opacity:.6;font-size:.6rem">/${sc.exam}</span></th><th style="border-right:2px solid rgba(255,255,255,.15)">Total<br><span style="opacity:.6;font-size:.6rem">/${sc.total}</span></th>`;});fh+=`<th style="border-left:2px solid rgba(255,255,255,.15)">Avg%</th><th>Grade</th></tr>`;el('tbl-head').innerHTML=gh+fh;}
function rebuildCols(){buildHeader();const sc=getScheme();const rows=[...el('tbl-body').querySelectorAll('tr')];if(!rows.length){if(fSubjects.length){addStudentRow();addStudentRow();addStudentRow();}return;}rows.forEach(row=>{const nv=row.cells[0].querySelector('input').value,pv=row.cells[1].querySelector('input').value,rid=row.id;const oldScores=[];for(let i=0;i<fSubjects.length;i++){const base=2+i*4;if(row.cells[base]){oldScores.push([row.cells[base].querySelector('input')?.value||'',row.cells[base+1]?.querySelector('input')?.value||'',row.cells[base+2]?.querySelector('input')?.value||'']);}else{oldScores.push(['','','']);}}row.innerHTML=buildRowCells(rid,nv,pv,oldScores,sc);attachAutoCalc(row,sc);});syncRemarksPanel();}
function buildRowCells(rid,nv,pv,oldScores,sc){let cells=`<td><input type="text" placeholder="Full Name" value="${(nv||'').replace(/"/g,'&quot;')}" style="min-width:110px" oninput="syncRemarksPanel()"></td><td><input type="tel" placeholder="08012345678" value="${pv||''}" style="min-width:100px"></td>`;fSubjects.forEach((s,i)=>{const os=oldScores[i]||['','',''];cells+=`<td style="border-left:2px solid var(--border)"><input type="number" class="score-inp" min="0" max="${sc.ca1}" placeholder="—" value="${os[0]}"></td><td><input type="number" class="score-inp" min="0" max="${sc.ca2}" placeholder="—" value="${os[1]}"></td><td><input type="number" class="score-inp" min="0" max="${sc.exam}" placeholder="—" value="${os[2]}"></td><td class="total-cell subj-sep" id="${rid}-t${i}">—</td>`;});cells+=`<td class="pct-cell" id="${rid}-avg">—</td><td id="${rid}-grd">—</td><td><button class="btn-row-del" onclick="removeRow('${rid}')">×</button></td>`;return cells;}
function removeRow(rid){document.getElementById(rid)?.remove();syncRemarksPanel();}
function addStudentRow(){if(!fSubjects.length){alert('Please add at least one subject first.');return;}rowCnt++;const rid='r'+rowCnt,sc=getScheme(),tr=document.createElement('tr');tr.id=rid;tr.innerHTML=buildRowCells(rid,'','',fSubjects.map(()=>['','','']),sc);el('tbl-body').appendChild(tr);attachAutoCalc(tr,sc);syncRemarksPanel();}
function attachAutoCalc(row,sc){const rid=row.id;row.querySelectorAll('input[type="number"]').forEach(inp=>inp.addEventListener('input',()=>recalcRow(row,rid,sc)));recalcRow(row,rid,sc);}
function recalcRow(row,rid,sc){let totalScored=0,totalMax=0;fSubjects.forEach((s,i)=>{const base=2+i*4;const ca1=parseFloat(row.cells[base]?.querySelector('input')?.value)||0,ca2=parseFloat(row.cells[base+1]?.querySelector('input')?.value)||0,exam=parseFloat(row.cells[base+2]?.querySelector('input')?.value)||0,subTotal=ca1+ca2+exam;const tCell=el(rid+'-t'+i);if(tCell)tCell.textContent=subTotal||'—';totalScored+=subTotal;totalMax+=sc.total;});const avg=totalMax>0?Math.round((totalScored/totalMax)*100):0;const avgCell=el(rid+'-avg'),grdCell=el(rid+'-grd');if(avgCell)avgCell.textContent=totalScored?avg+'%':'—';if(grdCell){const g=grade(avg);grdCell.textContent=totalScored?g:'—';grdCell.className='g'+g;}}
function syncRemarksPanel(){const rows=[...el('tbl-body').querySelectorAll('tr')];const students=rows.map(r=>r.cells[0].querySelector('input').value.trim()).filter(Boolean);if(!students.length||!fSubjects.length){el('remarks-card').style.display='none';return;}el('remarks-card').style.display='block';const existing={};el('individual-remarks-list').querySelectorAll('.srb-body textarea').forEach((ta,i)=>{const nameEl=el('individual-remarks-list').querySelectorAll('.srb-name')[i];if(nameEl)existing[nameEl.textContent.trim()]=ta.value;});el('individual-remarks-list').innerHTML=students.map((name,i)=>`<div class="student-remark-block"><div class="srb-header" onclick="toggleSRB('t-srb-${i}',this)"><div class="srb-name">${name}</div><span class="srb-toggle">▼</span></div><div class="srb-body" id="t-srb-${i}"><label style="margin-bottom:.4rem">Teacher's Remark for ${name.split(' ')[0]}</label><textarea id="t-rem-${i}" placeholder="e.g. Very hardworking and focused. Keep it up!">${existing[name]||''}</textarea></div></div>`).join('');}
function saveResults(){const term=v('up-term'),cls=v('up-class'),session=v('up-session'),err=el('up-err');err.style.display='none';if(!term||!cls||!session)return showErr(err,'Please fill in Term Title, Class, and Session.');if(!fSubjects.length)return showErr(err,'Please add at least one subject.');const sc=getScheme(),rows=el('tbl-body').querySelectorAll('tr'),students=[];let remarkIdx=0;for(const row of rows){const name=row.cells[0].querySelector('input').value.trim(),phone=row.cells[1].querySelector('input').value.trim().replace(/\s/g,'');if(!name&&!phone)continue;if(!name||!phone)return showErr(err,'Every student needs a name and parent phone number.');const subjects={};let anyScore=false;for(let i=0;i<fSubjects.length;i++){const base=2+i*4,ca1r=row.cells[base]?.querySelector('input')?.value.trim(),ca2r=row.cells[base+1]?.querySelector('input')?.value.trim(),exr=row.cells[base+2]?.querySelector('input')?.value.trim();const ca1=ca1r===''?null:parseFloat(ca1r),ca2=ca2r===''?null:parseFloat(ca2r),exam=exr===''?null:parseFloat(exr);if(ca1!==null&&(isNaN(ca1)||ca1<0||ca1>sc.ca1))return showErr(err,`"${name}": ${fSubjects[i].name} CA1 must be 0–${sc.ca1}.`);if(ca2!==null&&(isNaN(ca2)||ca2<0||ca2>sc.ca2))return showErr(err,`"${name}": ${fSubjects[i].name} CA2 must be 0–${sc.ca2}.`);if(exam!==null&&(isNaN(exam)||exam<0||exam>sc.exam))return showErr(err,`"${name}": ${fSubjects[i].name} Exam must be 0–${sc.exam}.`);const total=(ca1||0)+(ca2||0)+(exam||0);subjects[fSubjects[i].name]={ca1,ca2,exam,total};if(ca1!==null||ca2!==null||exam!==null)anyScore=true;}if(!anyScore)return showErr(err,`"${name}" has no scores.`);const entered=Object.values(subjects).filter(s=>s.ca1!==null||s.ca2!==null||s.exam!==null),totalScored=entered.reduce((a,s)=>a+s.total,0),totalMax=entered.length*sc.total,avg=Math.round((totalScored/totalMax)*100),tRem=el('t-rem-'+remarkIdx)?.value.trim()||'';students.push({name,phone,subjects,totalScored,totalMax,avg,grade:grade(avg),teacherRemark:tRem,htRemark:'',owesDebt:false});remarkIdx++;}if(!students.length)return showErr(err,'Please add at least one student.');const data=load();data.results.push({id:uid(),teacherId:cTeacher.id,teacherName:cTeacher.name,term,cls,session,scheme:sc,subjects:fSubjects.map(s=>s.name),students,createdAt:new Date().toLocaleDateString()});save(data);alert('✅ Results saved and published!');showScreen('teacher-dashboard');}
function viewDetail(rid){cResultId=rid;const data=load(),r=data.results.find(x=>x.id===rid);if(!r)return;const avgs=r.students.map(s=>s.avg),classAvg=avgs.length?Math.round(avgs.reduce((a,b)=>a+b,0)/avgs.length):0,sc=r.scheme,subjAvgs=r.subjects.map(sn=>{const vals=r.students.map(s=>s.subjects[sn]?.total||0);return{name:sn,avg:(vals.reduce((a,b)=>a+b,0)/vals.length).toFixed(1),max:sc.total};});el('detail-content').innerHTML=`<div class="sh">${r.term}</div><div class="ss">${r.cls} · ${r.session} · ${r.createdAt}</div><div class="notice n-warn">Score scheme: CA1(${sc.ca1}) + CA2(${sc.ca2}) + Exam(${sc.exam}) = ${sc.total}</div><div class="stat-grid"><div class="stat-card"><div class="stat-n">${classAvg}%</div><div class="stat-l">Class Avg</div></div><div class="stat-card"><div class="stat-n">${r.students.length}</div><div class="stat-l">Students</div></div><div class="stat-card"><div class="stat-n">${avgs.length?Math.max(...avgs):0}%</div><div class="stat-l">Highest</div></div><div class="stat-card"><div class="stat-n">${avgs.length?Math.min(...avgs):0}%</div><div class="stat-l">Lowest</div></div></div><div style="font-family:'Playfair Display',serif;font-size:1.05rem;font-weight:700;margin-bottom:.65rem">Subject Averages</div><div class="card" style="padding:.75rem 1.25rem;margin-bottom:1rem">${subjAvgs.map(sa=>`<div style="display:flex;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid var(--border)"><span style="font-weight:600;font-size:.88rem">${sa.name}</span><span style="color:var(--muted);font-size:.85rem">${sa.avg} / ${sa.max}</span></div>`).join('')}</div><div style="font-family:'Playfair Display',serif;font-size:1.05rem;font-weight:700;margin-bottom:.65rem">Students</div><div style="overflow-x:auto;border:1.5px solid var(--border);border-radius:var(--r);background:#fff;margin-bottom:1.5rem"><table class="stbl" style="min-width:${200+r.subjects.length*160}px"><thead><tr class="gh"><th rowspan="2" style="text-align:left;vertical-align:botto